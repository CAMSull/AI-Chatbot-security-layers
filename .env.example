# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore.

# --- Layer 1: Authentication -------------------------------------------------
# Comma-separated "raw_key:username" pairs. Generate strong random keys, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=dev-local-key:demo-user

# --- Layer 2: Input validation -------------------------------------------------
MAX_INPUT_LENGTH=2000

# --- Layer 3: Rate limiting -----------------------------------------------------
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Layer 4: Content moderation (Azure AI Content Safety) ---------------------
# Leave blank to use the local heuristic fallback moderator instead.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_SEVERITY_THRESHOLD=4

# --- Layer 5: Output filtering / audit logging ----------------------------------
LOG_FILE=audit.log
# Only set to true for local debugging - never in a real deployment.
LOG_RAW_MESSAGES=false

# --- Azure OpenAI (the model itself) ---------------------------------------------
# Leave all three blank to run in MOCK_MODE (deterministic placeholder replies),
# which lets you demo the full security pipeline without an Azure subscription.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Force mock mode even if Azure OpenAI credentials are present.
MOCK_MODE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
